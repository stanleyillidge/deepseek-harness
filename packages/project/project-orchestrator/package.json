{
  "name": "@deepseek-ai/dsh-project-orchestrator",
  "description": "Orquestador determinista de DAGs con paralelismo seguro, verificación y recovery",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/project/project-orchestrator"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-project-resource-lease": "workspace:*",
    "@deepseek-ai/dsh-project-worker": "workspace:*",
    "@deepseek-ai/dsh-project-verifier": "workspace:*",
    "@deepseek-ai/dsh-project-recovery": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-project-resource-lease": "workspace:*",
    "@deepseek-ai/dsh-project-worker": "workspace:*",
    "@deepseek-ai/dsh-project-verifier": "workspace:*",
    "@deepseek-ai/dsh-project-recovery": "workspace:*"
  }
}
